#!/bin/sh
# Weigert lokale commits op main; werk gebeurt op een eigen branch in een eigen worktree.
branch=$(git symbolic-ref --short -q HEAD)
if [ "$branch" = "main" ]; then
  echo "Commit op main geweigerd. Maak een eigen worktree en branch, zie CONTRIBUTING.md (Werkwijze per agentsessie)." >&2
  exit 1
fi
